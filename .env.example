# ─────────────────────────────────────────────────────────────
#  DeskFlow — environment variables
#  Copy this file to `.env` and fill in real values.
#  On Vercel, add each of these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (free M0 cluster works fine)
# https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/deskflow?retryWrites=true&w=majority

# JWT signing secret — use a long random string:  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public URL of the deployed app (used in email links). No trailing slash.
APP_URL=http://localhost:5173

# --- Outbound email ---
# Primary provider: SendGrid (free tier = 100 emails/day)
# https://signup.sendgrid.com/
SENDGRID_API_KEY=
EMAIL_FROM="DeskFlow Support <support@yourdomain.com>"
EMAIL_FROM_NAME=DeskFlow Support

# Optional SMTP fallback (used only if SENDGRID_API_KEY is empty).
# Works with any SMTP provider — Brevo, Mailtrap, Gmail app password, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Inbound email → ticket ---
# Secret token appended to the SendGrid Inbound Parse webhook URL:
#   https://your-app.vercel.app/api/webhooks/inbound-email?token=THIS
INBOUND_WEBHOOK_TOKEN=change-me-inbound-secret

# --- Optional IMAP poller (server/scripts/imapWorker.js) ---
# Use this instead of Inbound Parse when running on an always-on box (e.g. a VPS)
# and you just want to poll a normal mailbox (Gmail app password, etc.)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECONDS=60
